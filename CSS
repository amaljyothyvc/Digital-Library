{`* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f4f6fb;
  color: #17233c;
  line-height: 1.6;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

#form {
  width: 420px;
  max-width: 90%;
  margin: 80px auto;
  padding: 40px;
  background: white;
  border-radius: 20px;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
}

#form h1 {
  margin-bottom: 8px;
  font-size: 30px;
}

#form p {
  color: #718096;
  margin-bottom: 30px;
}

#form label {
  display: block;
  margin-top: 18px;
  margin-bottom: 7px;
  font-weight: 600;
}

#form input {
  width: 100%;
  padding: 13px 15px;
  border: 1px solid #d8deea;
  border-radius: 10px;
  outline: none;
  transition: 0.2s;
}

#form input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

#form button {
  width: 100%;
  margin-top: 25px;
  padding: 13px;
  border: none;
  border-radius: 10px;
  background: #6366f1;
  color: white;
  font-weight: 700;
  transition: 0.2s;
}

#form button:hover {
  background: #4f46e5;
  transform: translateY(-1px);
}

.navbar {
  height: 72px;
  background: white;
  border-bottom: 1px solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 7%;
}

.logo {
  font-size: 22px;
  font-weight: 800;
  color: #17233c;
}

.account-btn {
  border: none;
  background: #eef0ff;
  color: #4f46e5;
  padding: 10px 18px;
  border-radius: 10px;
  font-weight: 600;
}

.account-btn:hover {
  background: #e0e2ff;
}

.container {
  width: 86%;
  max-width: 1200px;
  margin: auto;
}

.hero {
  padding: 65px 0 45px;
}

.hero h1 {
  font-size: 48px;
  line-height: 1.15;
  margin-bottom: 12px;
  color: #17233c;
}

.hero p {
  font-size: 18px;
  color: #718096;
}

.library-header {
  margin-bottom: 25px;
}

.section-label {
  display: inline-block;
  color: #6366f1;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1.5px;
  margin-bottom: 8px;
}

.library-header h2 {
  font-size: 32px;
  margin-bottom: 5px;
}

.library-header p {
  color: #718096;
}

.books-section {
  margin-bottom: 60px;
}

#library {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.book-card {
  position: relative;
  background: white;
  padding: 25px;
  border-radius: 16px;
  border: 1px solid #e5e7eb;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.book-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
}

.book-card::before {
  content: "📖";
  display: flex;
  width: 50px;
  height: 50px;
  align-items: center;
  justify-content: center;
  background: #eef0ff;
  border-radius: 12px;
  font-size: 24px;
  margin-bottom: 18px;
}

.book-card h2 {
  font-size: 21px;
  margin-bottom: 15px;
  color: #17233c;
}

.book-card p {
  margin: 7px 0;
  color: #667085;
}

.book-card p:last-child {
  display: inline-block;
  margin-top: 15px;
  padding: 6px 12px;
  border-radius: 20px;
  background: #eef0ff;
  color: #4f46e5;
  font-size: 13px;
  font-weight: 700;
}

.add-book-section {
  background: white;
  padding: 35px;
  border-radius: 20px;
  border: 1px solid #e5e7eb;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
  margin-bottom: 70px;
}

.add-book-section h2 {
  font-size: 28px;
  margin-bottom: 6px;
}

.add-book-section > p {
  color: #718096;
  margin-bottom: 30px;
}

#bookForm {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 8px;
  color: #344054;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 13px 15px;
  border: 1px solid #d8deea;
  border-radius: 10px;
  background: white;
  outline: none;
  transition: 0.2s;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

#bookForm button {
  grid-column: 1 / -1;
  width: fit-content;
  padding: 13px 25px;
  border: none;
  border-radius: 10px;
  background: #6366f1;
  color: white;
  font-weight: 700;
  transition: 0.2s;
}

#bookForm button:hover {
  background: #4f46e5;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
}

footer {
  background: #17233c;
  color: white;
  padding: 35px 7%;
  text-align: center;
}

.footer-logo {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 8px;
}

footer p {
  color: #aeb8ca;
  font-size: 14px;
}

@media (max-width: 900px) {
  #library {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero h1 {
    font-size: 40px;
  }
}

@media (max-width: 650px) {
  .navbar {
    padding: 0 5%;
  }

  .logo {
    font-size: 18px;
  }

  .account-btn {
    padding: 8px 12px;
    font-size: 13px;
  }

  .container {
    width: 90%;
  }

  .hero {
    padding: 45px 0 30px;
  }

  .hero h1 {
    font-size: 34px;
  }

  #library {
    grid-template-columns: 1fr;
  }

  #bookForm {
    grid-template-columns: 1fr;
  }

  #bookForm button {
    width: 100%;
  }

  .add-book-section {
    padding: 25px;
  }
}

[hidden] {
  display: none !important;
}`}
