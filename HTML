<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">
    <title>My Digital Library</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <form id="form">
        <div id="step1">
            <h1>📚 Welcome</h1>
            <p>
                Create your digital library account.
            </p>
            <label for="username">
                Username
            </label>
            <input
                type="text"
                id="username"
                placeholder="Enter your username"
                required
            >
            <label for="email">
                Email
            </label>
            <input
                type="email"
                id="email"
                placeholder="Enter your email"
                required
            >
            <button
                type="button"
                id="nextButton">
                Continue
            </button>
        </div>
        <div id="step2" hidden>
            <h1>🔐 Create Password</h1>
            <p>
                Secure your library account.
            </p>
            <label for="password">
                Password
            </label>
            <input
                type="password"
                id="password"
                placeholder="Enter password"
                required
            >
            <label for="confirmPassword">
                Confirm Password
            </label>

            <input
                type="password"
                id="confirmPassword"
                placeholder="Confirm password"
                required
            >
            <button type="submit">
                Create Account
            </button>
        </div>
    </form>
    <div id="librarySection" hidden>
        <nav class="navbar">

            <div class="logo">
                📚 My Digital Library
            </div>
            <button
                type="button"
                class="account-btn">

                👤 My Account

            </button>

        </nav>
        <main class="container">


            <!-- HERO -->

            <section class="hero">

                <h1>
                    Your Personal Library
                </h1>

                <p>
                    Keep track of everything you're reading.
                </p>

            </section>
            <section class="library-header">

                <span class="section-label">
                    YOUR COLLECTION
                </span>

                <h2>
                    My Books
                </h2>

                <p>
                    Your personal collection
                </p>

            </section>

            <section class="books-section">

                <div id="library"></div>

            </section>
            <section class="add-book-section">

                <h2>
                    Add a New Book
                </h2>

                <p>
                    Add a book to your personal collection.
                </p>
                <form id="bookForm">
                    <!-- BOOK TITLE -->
                    <div class="form-group">

                        <label for="title">
                            Book Title
                        </label>

                        <input
                            type="text"
                            id="title"
                            placeholder="e.g. The Hobbit"
                            required
                        >
                    </div>
                    <!-- AUTHOR -->

                    <div class="form-group">

                        <label for="author">
                            Author
                        </label>

                        <input
                            type="text"
                            id="author"
                            placeholder="e.g. J.R.R. Tolkien"
                            required
                        >

                    </div>
                    <!-- PAGES -->
                    <div class="form-group">
                        <label for="pages">
                            Pages
                        </label>

                        <input
                            type="number"
                            id="pages"
                            placeholder="310"
                            min="1"
                            required
                        >
                    </div>
                    <!-- STATUS -->

                    <div class="form-group">

                        <label for="status">
                            Reading Status
                        </label>
 <select id="status">

                    <option value="Read">
                                ✓ Read
                            </option>

                            <option value="Reading">
                                📖 Reading
                            </option>

                            <option value="To Read">
                                📚 To Read
                            </option>

                        </select>

                    </div>
                    <button type="submit">
                        + Add Book
                    </button>
                </form>
            </section>
        </main>
        <footer>
            <div class="footer-logo">
                📚 My Digital Library
            </div>
<p>
                Built with HTML • CSS • JavaScript • Node.js
            </p>
        </footer>
    </div>
    <script src="./script.js"></script>
</body>
</html>
